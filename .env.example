# SSDI Campaigns — environment (never commit secrets)
# Independent campaign. Not CaseClosedFL. Not SSA.

# --- HubSpot (PRIMARY CRM) ---
# Private app in the SSDI HubSpot portal only.
HUBSPOT_ACCESS_TOKEN=

# --- Google Sheets (BACKUP / FAILOVER ONLY) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Leads!A1
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# Or paste the full service-account JSON:
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# --- Resend (ssdicampaigns.com ONLY — never CaseClosedFL keys/domains) ---
# Verify ssdicampaigns.com in the SSDI Resend project before sending:
#   Resend → Domains → Add ssdicampaigns.com → add DNS (SPF + DKIM, optional DMARC)
#   wait until status is Verified, then From noreply@ssdicampaigns.com will deliver.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SSDI Campaigns <noreply@ssdicampaigns.com>
RESEND_REPLY_TO=Intake@abbycrm.com
# INTAKE_NOTIFY_EMAIL=Intake@abbycrm.com

# --- Public click-to-call (SSDI Vapi inbound — never CaseClosedFL +15615661360) ---
# After the SSDI Vapi assistant/number exists, set both and rebuild the web image.
VITE_PUBLIC_PHONE=
INBOUND_PHONE_NUMBER=

# --- Vapi (separate SSDI assistant — no CaseClosedFL assistant IDs) ---
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=

# Optional: frontend posts to the standalone intake API instead of in-process HubSpot.
# INTAKE_API_URL=http://127.0.0.1:8787
