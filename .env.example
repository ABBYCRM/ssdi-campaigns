# SSDI Campaigns — environment (never commit secrets)
# Independent campaign. Not SSA. Do not reuse tokens, domains, or inbound
# numbers from any other ABBYCRM product.

# --- HubSpot (PRIMARY CRM — SSDI private app only. NOT a stub.) ---
# Full setup: docs/HUBSPOT.md
# Create a NEW private app named "SSDI Campaigns". Preferred: a separate
# SSDI portal. Same AbbyCRM portal 247081451 is OK with this dedicated app
# (ssdi_* properties / SSDI Campaigns pipeline only — never MVA intake_*).
# NEVER reuse a CaseClosedFL token or __HUBSPOT_ACCESS_TOKEN__ placeholder.
# Scopes:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.schemas.contacts.write   (ssdi_* properties + ssdi_campaigns_intake group)
#   crm.objects.notes.write      (intake + validation NOTES)
#   crm.objects.deals.read
#   crm.objects.deals.write
#   crm.schemas.deals.write      (SSDI Campaigns pipeline)
#   forms                        (optional Forms v3 submit)
HUBSPOT_ACCESS_TOKEN=
# Optional. Preferred: dedicated SSDI portal. 247081451 is allowed for SSDI.
HUBSPOT_PORTAL_ID=
# Optional SSDI form GUID ("SSDI Campaigns Intake"). CRM upsert still runs without it.
HUBSPOT_FORM_ID=

# --- Google Sheets (BACKUP / FAILOVER ONLY) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Leads!A1
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# Or paste the full service-account JSON:
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# --- SSDI-Validator (ABBYCRM/SSDI-Validator) ---
# After a successful /intake, POST {SSDI_VALIDATOR_URL}/v1/validations
# with Authorization: Bearer {SSDI_VALIDATOR_TOKEN} (prefix ssdi_live_).
# Leave empty until that service is live — the client stubs as unwired.
SSDI_VALIDATOR_URL=
SSDI_VALIDATOR_TOKEN=
# SSDI_VALIDATOR_TIMEOUT_MS=25000

# --- SSDI-portal desk (ABBYCRM/SSDI-portal) ---
# POST {SSDI_PORTAL_URL}/api/webhooks/intake  header x-webhook-secret
# Leave empty until that service is live — the client stubs as unwired.
SSDI_PORTAL_URL=
SSDI_PORTAL_WEBHOOK_SECRET=

# --- Resend (ssdicampaigns.com ONLY) ---
# Verify ssdicampaigns.com in the SSDI Resend project before sending:
#   Resend → Domains → Add ssdicampaigns.com → add DNS (SPF + DKIM, optional DMARC)
#   wait until status is Verified, then From noreply@ssdicampaigns.com will deliver.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SSDI Campaigns <noreply@ssdicampaigns.com>
RESEND_REPLY_TO=Intake@abbycrm.com
# INTAKE_NOTIFY_EMAIL=Intake@abbycrm.com

# --- Public click-to-call (SSDI Vapi inbound) ---
VITE_PUBLIC_PHONE=+15616520362
INBOUND_PHONE_NUMBER=+15616520362

# --- Vapi (SSDI assistant c0f5dd63-3c51-4eb6-9f62-8a6e2391c954) ---
# Server URL: https://ssdicampaigns.com/api/vapi/inbound
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=c0f5dd63-3c51-4eb6-9f62-8a6e2391c954

# Optional: frontend posts to the standalone intake API instead of in-process HubSpot.
# INTAKE_API_URL=http://127.0.0.1:8787
