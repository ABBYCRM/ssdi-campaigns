# SSDI Campaigns — environment (never commit secrets)
# Independent campaign. Not CaseClosedFL. Not SSA.

# --- HubSpot (PRIMARY CRM) ---
# Private app in the SSDI HubSpot portal only.
HUBSPOT_ACCESS_TOKEN=

# --- Google Sheets (BACKUP / FAILOVER ONLY) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Leads!A1
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# Or paste the full service-account JSON:
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# --- Resend (ssdicampaigns.com ONLY — never CaseClosedFL keys/domains) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=SSDI Campaigns <noreply@ssdicampaigns.com>
RESEND_REPLY_TO=info@ssdicampaigns.com
# INTAKE_NOTIFY_EMAIL=ops@ssdicampaigns.com

# --- Vapi (separate SSDI assistant — no CaseClosedFL assistant IDs) ---
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=

# Optional: frontend posts to the standalone intake API instead of in-process HubSpot.
# INTAKE_API_URL=http://127.0.0.1:8787
